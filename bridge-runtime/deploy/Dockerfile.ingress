# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd
ARG NODE_IMAGE=node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY bridge-runtime/ingress/go.mod bridge-runtime/ingress/go.sum ./
RUN go mod download
COPY bridge-runtime/ingress/cmd ./cmd
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/agent-life-tsnet ./cmd/agent-life-tsnet

FROM ${NODE_IMAGE} AS runtime
RUN groupadd --system --gid 10000 agent-life \
  && useradd --system --uid 10001 --gid 10000 --home-dir /nonexistent --shell /usr/sbin/nologin agent-life-ingress \
  && mkdir -p /var/lib/agent-life-ingress /run/agent-life \
  && chown -R 10001:10000 /var/lib/agent-life-ingress /run/agent-life \
  && chmod 0750 /var/lib/agent-life-ingress /run/agent-life
COPY --from=build --chown=10001:10000 /out/agent-life-tsnet /usr/local/bin/agent-life-tsnet
USER 10001:10000
VOLUME ["/var/lib/agent-life-ingress"]
ENTRYPOINT ["/usr/local/bin/agent-life-tsnet"]

[Unit]
Description=Agent Life private Bridge (userspace Tailnet ingress)
After=network-online.target
Wants=network-online.target
# The service is intentionally not startable until the controller has supplied
# an immutable tsnet lock and adapter. The runtime itself also fails closed.
ConditionPathExists=/etc/agent-life/tsnet.locked

[Service]
Type=simple
User=agent-life-bridge
Group=agent-life-bridge
WorkingDirectory=/var/lib/agent-life-bridge
Environment=NODE_ENV=production
Environment=BRIDGE_INGRESS_TRANSPORT=tsnet-userspace
Environment=BRIDGE_INGRESS_PORT=443
Environment=BRIDGE_TSNET_LOCK=/etc/agent-life/tsnet.locked
ExecStart=/usr/bin/node /opt/agent-life-bridge/dist/main.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-life-bridge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No ListenStream/ListenDatagram is declared here: the userspace Tailnet
# adapter owns the private listener and no public wildcard socket is opened.

[Install]
WantedBy=multi-user.target

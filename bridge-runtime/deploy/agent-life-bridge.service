[Unit]
Description=Agent Life durable Bridge runtime
Requires=agent-life-ingress.service
After=agent-life-ingress.service
ConditionPathExists=/etc/agent-life/bridge/pairing-ticket-public.pem

[Service]
Type=simple
User=agent-life-runtime
Group=agent-life
SupplementaryGroups=agent-life
WorkingDirectory=/var/lib/agent-life-bridge
StateDirectory=agent-life-bridge
StateDirectoryMode=0750
RuntimeDirectory=agent-life
RuntimeDirectoryMode=0750
Environment=NODE_ENV=production
Environment=AGENT_LIFE_DATABASE=/var/lib/agent-life-bridge/bridge.sqlite
Environment=AGENT_LIFE_PAIRING_PUBLIC_KEY=/etc/agent-life/bridge/pairing-ticket-public.pem
Environment=AGENT_LIFE_RUNTIME_SOCKET=/run/agent-life/runtime.sock
Environment=AGENT_LIFE_LEASE_TTL_MS=60000
ExecStart=/usr/bin/node /opt/agent-life/bridge/dist/bridge-runtime/src/main.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-life-bridge
RestrictAddressFamilies=AF_UNIX
# The runtime accepts only the authenticated ingress sidecar over this Unix
# socket. It never opens a TCP listener or a public host port.

[Install]
WantedBy=multi-user.target

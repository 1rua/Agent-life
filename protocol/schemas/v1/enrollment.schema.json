{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-life:protocol:v1:enrollment",
  "type": "object",
  "unevaluatedProperties": false,
  "$defs": {
    "version_array": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/protocol_version" }
    },
    "enrollment_challenge": {
      "$id": "urn:agent-life:protocol:v1:message:enrollment_challenge",
      "type": "object",
      "required": ["challenge", "bridge_nonce", "bridge_fingerprint", "bridge_command_public_jwk", "supported_versions"],
      "properties": {
        "challenge": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/b64u32" },
        "bridge_nonce": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/b64u32" },
        "bridge_fingerprint": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/sha256_b64u" },
        "bridge_command_public_jwk": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/p256_public_jwk" },
        "supported_versions": { "$ref": "urn:agent-life:protocol:v1:enrollment#/$defs/version_array" }
      },
      "unevaluatedProperties": false
    },
    "enrollment_response": {
      "$id": "urn:agent-life:protocol:v1:message:enrollment_response",
      "type": "object",
      "required": ["ticket", "challenge_response", "device_public_jwk", "client_nonce", "supported_versions"],
      "properties": {
        "ticket": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/b64u32" },
        "challenge_response": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/b64u32" },
        "device_public_jwk": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/p256_public_jwk" },
        "client_nonce": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/b64u32" },
        "supported_versions": { "$ref": "urn:agent-life:protocol:v1:enrollment#/$defs/version_array" }
      },
      "unevaluatedProperties": false
    },
    "enrollment_complete": {
      "$id": "urn:agent-life:protocol:v1:message:enrollment_complete",
      "type": "object",
      "required": ["device_id", "pairing_generation", "tenant_id", "human_principal_id", "agent_instance_id", "enrollment_scope_ceiling", "selected_protocol", "client_nonce", "bridge_nonce", "bridge_fingerprint", "device_jwk_thumbprint"],
      "properties": {
        "device_id": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/opaque_server_id" },
        "pairing_generation": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/decimal_u64" },
        "tenant_id": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/opaque_server_id" },
        "human_principal_id": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_instance_id": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/opaque_server_id" },
        "enrollment_scope_ceiling": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/scope" } },
        "selected_protocol": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/protocol_version" },
        "client_nonce": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/b64u32" },
        "bridge_nonce": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/b64u32" },
        "bridge_fingerprint": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/sha256_b64u" },
        "device_jwk_thumbprint": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/sha256_b64u" }
      },
      "unevaluatedProperties": false
    },
    "enrollment_error": {
      "$id": "urn:agent-life:protocol:v1:message:enrollment_error",
      "oneOf": [
        {
          "type": "object", "required": ["code"],
          "properties": { "code": { "enum": ["MESSAGE_TOO_LARGE", "SCHEMA_INVALID", "AUTH_FAILED", "INTEGRITY_FAILED", "MESSAGE_EXPIRED", "AUTH_BINDING_MISMATCH", "VERSION_UNSUPPORTED"] } },
          "unevaluatedProperties": false
        },
        {
          "type": "object", "required": ["code", "retry_after_seconds"],
          "properties": { "code": { "const": "RATE_LIMITED" }, "retry_after_seconds": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/decimal_u64" } },
          "unevaluatedProperties": false
        }
      ]
    },
    "app_header": {
      "$id": "urn:agent-life:protocol:v1:header:enrollment_app_to_bridge",
      "type": "object",
      "required": ["protocol_version", "message_schema", "message_type", "message_id", "key_id", "direction", "issued_at", "expires_at", "payload_digest", "enrollment_ticket_digest"],
      "properties": {
        "protocol_version": { "const": "1.0" }, "message_schema": { "const": "urn:agent-life:protocol:v1:message:enrollment_response" }, "message_type": { "const": "enrollment_response" },
        "message_id": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/lowercase_uuid_v4" }, "key_id": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/opaque_server_id" }, "direction": { "const": "app-to-bridge" },
        "issued_at": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/timestamp" }, "expires_at": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/timestamp" }, "payload_digest": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/sha256_b64u" }, "enrollment_ticket_digest": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/sha256_b64u" }
      },
      "unevaluatedProperties": false
    },
    "bridge_header": {
      "$id": "urn:agent-life:protocol:v1:header:enrollment_bridge_to_app",
      "type": "object",
      "required": ["protocol_version", "message_schema", "message_type", "message_id", "key_id", "direction", "issued_at", "expires_at", "payload_digest", "enrollment_ticket_digest"],
      "properties": {
        "protocol_version": { "const": "1.0" }, "message_schema": { "enum": ["urn:agent-life:protocol:v1:message:enrollment_challenge", "urn:agent-life:protocol:v1:message:enrollment_complete", "urn:agent-life:protocol:v1:message:enrollment_error"] }, "message_type": { "enum": ["enrollment_challenge", "enrollment_complete", "enrollment_error"] },
        "message_id": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/lowercase_uuid_v4" }, "key_id": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/opaque_server_id" }, "direction": { "const": "bridge-to-app" },
        "issued_at": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/timestamp" }, "expires_at": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/timestamp" }, "payload_digest": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/sha256_b64u" }, "enrollment_ticket_digest": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/sha256_b64u" }
      },
      "unevaluatedProperties": false
    },
    "app_envelope": {
      "$id": "urn:agent-life:protocol:v1:envelope:enrollment_app_to_bridge",
      "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "$ref": "urn:agent-life:protocol:v1:header:enrollment_app_to_bridge" }, "payload": { "$ref": "urn:agent-life:protocol:v1:message:enrollment_response" }, "signature": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/p1363_signature" } },
      "unevaluatedProperties": false
    },
    "bridge_envelope": {
      "$id": "urn:agent-life:protocol:v1:envelope:enrollment_bridge_to_app",
      "oneOf": [
        { "$ref": "urn:agent-life:protocol:v1:enrollment#/$defs/challenge_envelope" }, { "$ref": "urn:agent-life:protocol:v1:enrollment#/$defs/complete_envelope" }, { "$ref": "urn:agent-life:protocol:v1:enrollment#/$defs/error_envelope" }
      ]
    },
    "challenge_envelope": {
      "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "allOf": [{ "$ref": "urn:agent-life:protocol:v1:header:enrollment_bridge_to_app" }, { "type": "object", "properties": { "message_type": { "const": "enrollment_challenge" }, "message_schema": { "const": "urn:agent-life:protocol:v1:message:enrollment_challenge" } } }] }, "payload": { "$ref": "urn:agent-life:protocol:v1:message:enrollment_challenge" }, "signature": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false
    },
    "complete_envelope": {
      "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "allOf": [{ "$ref": "urn:agent-life:protocol:v1:header:enrollment_bridge_to_app" }, { "type": "object", "properties": { "message_type": { "const": "enrollment_complete" }, "message_schema": { "const": "urn:agent-life:protocol:v1:message:enrollment_complete" } } }] }, "payload": { "$ref": "urn:agent-life:protocol:v1:message:enrollment_complete" }, "signature": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false
    },
    "error_envelope": {
      "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "allOf": [{ "$ref": "urn:agent-life:protocol:v1:header:enrollment_bridge_to_app" }, { "type": "object", "properties": { "message_type": { "const": "enrollment_error" }, "message_schema": { "const": "urn:agent-life:protocol:v1:message:enrollment_error" } } }] }, "payload": { "$ref": "urn:agent-life:protocol:v1:message:enrollment_error" }, "signature": { "$ref": "urn:agent-life:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-life.dev/schemas/gateway/v2/session.schema.json",
  "$defs": {
    "password": {
      "type": "object",
      "additionalProperties": false,
      "required": ["negotiationId", "username", "password", "installation"],
      "properties": {
        "negotiationId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "username": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installationId", "displayName", "devicePublicKey"],
          "properties": {
            "installationId": {
              "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
            },
            "displayName": { "type": "string", "minLength": 1 },
            "devicePublicKey": {
              "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/base64urlEd25519PublicKey"
            }
          }
        }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negotiationId",
        "accountId",
        "installationId",
        "deviceId",
        "refreshCredential"
      ],
      "properties": {
        "negotiationId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "accountId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "installationId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "deviceId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "refreshCredential": { "type": "string", "minLength": 1 }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["negotiationId", "installationId", "deviceId", "challenge", "signature"],
      "oneOf": [
        {
          "required": ["accountId"],
          "properties": { "accountId": true }
        },
        {
          "required": ["username"],
          "properties": { "username": true }
        }
      ],
      "properties": {
        "negotiationId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "accountId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "username": { "type": "string", "minLength": 1 },
        "installationId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "deviceId": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "challenge": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "signature": {
          "$ref": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json#/$defs/base64urlEd25519Signature"
        }
      }
    }
  }
}

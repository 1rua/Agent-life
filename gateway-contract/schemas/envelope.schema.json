{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-life.dev/schemas/gateway/v2/envelope.schema.json",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[!-~]{1,128}$"
    },
    "utcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "bareSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefixedSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "correlationId", "protocol", "data"],
      "properties": {
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "correlationId": { "$ref": "#/$defs/opaqueId" },
        "protocol": { "const": "2.0" },
        "data": { "type": "object" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "correlationId", "protocol", "error"],
      "properties": {
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "correlationId": { "$ref": "#/$defs/opaqueId" },
        "protocol": { "const": "2.0" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "retryAfterSeconds", "details"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "retryAfterSeconds": {
              "anyOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "null" }
              ]
            },
            "details": { "type": "object" }
          }
        }
      }
    }
  }
}
